{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // Design contracts are documentation, not executable source files.
  "ignoreFiles": ["specs/**/contracts/**/*.ts"],
  // Keep exports that are used within their own module.
  "ignoreExportsUsedInFile": true,
  "workspaces": {
    ".": {
      "entry": [
        "scripts/verification/run.mjs",
        "scripts/verification/doctor.mjs",
        "scripts/verification/runtime.mjs",
        "scripts/verification/types.mjs",
        "scripts/verification/queries.mjs"
      ],
      // Nx loads this package dynamically for nx release.
      "ignoreDependencies": ["@nx/js"]
    },
    "examples/prisma-app": {
      "entry": ["verification/database.mjs", "verification/prisma.config.ts", "verification/schema.prisma"]
    },
    "packages/drizzle": {
      "entry": ["verification/database.mjs"],
      // The native resolver loads the optional ORM peer only when used.
      "ignoreIssues": {"package.json": ["optionalPeerDependencies"]}
    }
  }
}
