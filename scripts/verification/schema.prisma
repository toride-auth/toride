generator client {
  provider = "prisma-client-js"
  output = "./generated"
  engineType = "client"
}

datasource db {
  provider = "sqlite"
  url = env("LOCAL_PRISMA_URL")
}

model Document {
  id String @id
  tenant String
  blocked Boolean
  title String?
  rank Int?
  ownerId String?
  owner User? @relation(fields: [ownerId], references: [id])
  projectId String?
  project Project? @relation(fields: [projectId], references: [id])
  reviewers Reviewer[]
}

model Project {
  id String @id
  isPublic Boolean
  documents Document[]
}

model User {
  id String @id
  documents Document[]
  reviews Reviewer[]
}

model Reviewer {
  documentId String
  userId String
  approved Boolean
  document Document @relation(fields: [documentId], references: [id])
  user User @relation(fields: [userId], references: [id])
  @@id([documentId, userId])
}
